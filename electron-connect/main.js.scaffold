/**
 * TaxRocket Portal Agent - Main Process
 * Implements worker.md spec: persistent partition, deep link, localhost bridge, safeStorage
 */

const { app, BrowserWindow, ipcMain, safeStorage, protocol, session } = require('electron');
const path = require('path');
const http = require('http');
const { URL } = require('url');

// Config from env or defaults
const LOCAL_BRIDGE_PORT = 37219;
const BASE_URL = process.env.NEXTAUTH_URL || 'http://localhost:3000';

let mainWindow = null;
let currentPartitionKey = null;
let deviceToken = null; // Stored via safeStorage in production

// Handle deep link taxrocket-connect://
if (process.defaultApp) {
  if (process.argv.length >= 2) {
    app.setAsDefaultProtocolClient('taxrocket-connect', process.execPath, [path.resolve(process.argv[1])]);
  }
} else {
  app.setAsDefaultProtocolClient('taxrocket-connect');
}

const gotTheLock = app.requestSingleInstanceLock();
if (!gotTheLock) {
  app.quit();
} else {
  app.on('second-instance', (event, commandLine, workingDirectory) => {
    // Someone tried to run second instance, focus window and handle deep link
    if (mainWindow) {
      if (mainWindow.isMinimized()) mainWindow.restore();
      mainWindow.focus();
    }
    // Handle deep link from commandLine
    const deepLink = commandLine.find(arg => arg.startsWith('taxrocket-connect://'));
    if (deepLink) {
      handleDeepLink(deepLink);
    }
  });
}

function handleDeepLink(urlString) {
  console.log('[DeepLink] Received:', urlString);
  try {
    const url = new URL(urlString);
    const token = url.searchParams.get('token');
    const partition = url.searchParams.get('partition');
    const baseUrl = url.searchParams.get('baseUrl') || BASE_URL;

    if (token && partition) {
      currentPartitionKey = partition;
      deviceToken = token;
      // Store securely
      if (safeStorage.isEncryptionAvailable()) {
        const encrypted = safeStorage.encryptString(token);
        // In real app, save to file via safeStorage
        console.log('[DeepLink] Token encrypted and stored');
      }

      // Register device with backend
      registerDevice(token, baseUrl).then(() => {
        if (mainWindow) {
          mainWindow.webContents.send('deep-link-received', { token, partition, baseUrl });
        }
      });
    }
  } catch (e) {
    console.error('[DeepLink] Failed to parse:', e);
  }
}

async function registerDevice(launchToken, baseUrl = BASE_URL) {
  try {
    console.log(`[Register] Calling ${baseUrl}/api/fbr-connect/desktop/register`);
    const res = await fetch(`${baseUrl}/api/fbr-connect/desktop/register`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        launchToken,
        deviceName: `Desktop-${require('os').hostname()}`,
        platform: process.platform,
        version: app.getVersion(),
      }),
    });
    const data = await res.json();
    console.log('[Register] Response:', data);
    if (data.success) {
      deviceToken = launchToken; // Keep for polling
      currentPartitionKey = data.device.partitionKey;
      // Create or update window with correct partition
      createMainWindow(currentPartitionKey);
    }
    return data;
  } catch (e) {
    console.error('[Register] Failed:', e);
    return { success: false, error: e.message };
  }
}

function createMainWindow(partitionKey = null) {
  const partition = partitionKey ? `persist:${partitionKey}` : `persist:fbr-iris-default`;
  console.log(`[Main] Creating window with partition: ${partition}`);

  if (mainWindow) {
    mainWindow.close();
  }

  mainWindow = new BrowserWindow({
    width: 1280,
    height: 800,
    webPreferences: {
      partition,
      preload: path.join(__dirname, 'preload.js'),
      contextIsolation: true,
      nodeIntegration: false,
    },
    title: 'Tax Rocket Portal Agent',
  });

  // Load FBR IRIS or local agent UI
  const irisUrl = process.env.FBR_IRIS_LOGIN_URL || 'https://iris.fbr.gov.pk/';
  const useMock = process.env.FBR_USE_MOCK_IRIS === 'true';
  
  if (useMock) {
    mainWindow.loadFile(path.join(__dirname, 'mock-iris', 'login.html'));
  } else {
    // For dev, load local UI that shows status and has button to open IRIS
    mainWindow.loadFile(path.join(__dirname, 'renderer', 'index.html'));
  }

  mainWindow.on('closed', () => {
    mainWindow = null;
  });

  // Handle new window - keep in same partition
  mainWindow.webContents.setWindowOpenHandler(({ url }) => {
    console.log('[Main] Window open request:', url);
    // Allow IRIS navigation
    if (url.includes('fbr.gov.pk') || url.includes('localhost')) {
      return { action: 'allow' };
    }
    // Open external links in default browser
    require('electron').shell.openExternal(url);
    return { action: 'deny' };
  });
}

// Localhost bridge server for http://127.0.0.1:37219/connect?token=...
function startLocalBridge() {
  const server = http.createServer((req, res) => {
    const url = new URL(req.url, `http://127.0.0.1:${LOCAL_BRIDGE_PORT}`);
    console.log(`[Bridge] ${req.method} ${url.pathname}`);

    // CORS for local web app
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
    res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

    if (req.method === 'OPTIONS') {
      res.writeHead(200);
      res.end();
      return;
    }

    if (url.pathname === '/connect') {
      const token = url.searchParams.get('token');
      const partition = url.searchParams.get('partition');
      const baseUrl = url.searchParams.get('baseUrl') || BASE_URL;

      if (token) {
        handleDeepLink(`taxrocket-connect://connect?token=${token}&partition=${partition}&baseUrl=${encodeURIComponent(baseUrl)}`);
        res.writeHead(200, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ success: true, message: 'Connected to desktop agent', partition }));
        
        // Focus window
        if (mainWindow) {
          if (mainWindow.isMinimized()) mainWindow.restore();
          mainWindow.focus();
        } else {
          createMainWindow(partition);
        }
        return;
      }
    }

    if (url.pathname === '/status') {
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({
        success: true,
        running: true,
        partitionKey: currentPartitionKey,
        hasToken: !!deviceToken,
        version: app.getVersion(),
      }));
      return;
    }

    res.writeHead(404, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ success: false, error: 'Not found' }));
  });

  server.listen(LOCAL_BRIDGE_PORT, '127.0.0.1', () => {
    console.log(`[Bridge] Local bridge running on http://127.0.0.1:${LOCAL_BRIDGE_PORT}`);
  });

  server.on('error', (e) => {
    console.error('[Bridge] Failed to start:', e.message);
    if (e.code === 'EADDRINUSE') {
      console.log('[Bridge] Port in use - another instance may be running');
    }
  });
}

app.whenReady().then(() => {
  // Handle deep link on macOS
  app.on('open-url', (event, url) => {
    event.preventDefault();
    handleDeepLink(url);
  });

  // Check if launched via deep link
  const deepLinkArg = process.argv.find(arg => arg.startsWith('taxrocket-connect://'));
  if (deepLinkArg) {
    handleDeepLink(deepLinkArg);
  }

  startLocalBridge();

  // Create window if not already created via deep link
  if (!mainWindow) {
    createMainWindow(currentPartitionKey);
  }

  app.on('activate', () => {
    if (BrowserWindow.getAllWindows().length === 0) {
      createMainWindow(currentPartitionKey);
    }
  });
});

app.on('window-all-closed', () => {
  if (process.platform !== 'darwin') {
    app.quit();
  }
});

// IPC handlers for renderer
ipcMain.handle('get-device-info', () => ({
  partitionKey: currentPartitionKey,
  hasToken: !!deviceToken,
  version: app.getVersion(),
}));

ipcMain.handle('register-device', async (event, { launchToken, baseUrl }) => {
  return registerDevice(launchToken, baseUrl);
});

ipcMain.handle('mark-ready', async (event, { filingDraftId, baseUrl }) => {
  try {
    const url = `${baseUrl || BASE_URL}/api/fbr-connect/desktop/ready`;
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ deviceToken, filingDraftId }),
    });
    return await res.json();
  } catch (e) {
    return { success: false, error: e.message };
  }
});

console.log('[Main] TaxRocket Portal Agent starting...');
console.log('[Main] Base URL:', BASE_URL);
console.log('[Main] Bridge Port:', LOCAL_BRIDGE_PORT);
